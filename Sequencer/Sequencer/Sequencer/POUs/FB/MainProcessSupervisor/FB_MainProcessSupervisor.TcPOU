      <LineId Id="882" Count="2" />
      <LineId Id="970" Count="36" />
      <LineId Id="1010" Count="10" />
      <LineId Id="569" Count="66" />
      <LineId Id="936" Count="33" />
      <LineId Id="655" Count="84" />
      <LineId Id="741" Count="17" />
      <LineId Id="760" Count="18" />
      <LineId Id="780" Count="18" />
      <LineId Id="800" Count="11" />
      <LineId Id="172" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>