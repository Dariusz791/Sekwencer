<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_BigBagDischarge" Id="{c7a51148-0376-478c-8fe6-00445313d9b3}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_BigBagDischarge
VAR_INPUT
	//InCmd
    bEnable                     : BOOL;     // aktywacja bloku wysypu do Big Baga

	//Par
	rBagTargetMass_SP           : REAL;     // zadana masa aktualnego Big Baga
    rBatchDischargeToleranceKg  : REAL;     // tolerancja uznania, że bulk praktycznie cały już wyszedł
    uiFlapPosFast_SP            : UINT;     // pozycja klapy dla szybkiego wysypu
    uiFlapPosFine_SP            : UINT;     // pozycja klapy dla precyzyjnego wysypu
	tBulkDischargeTime_SP       : TIME;     // maksymalny czas wysypu w trybie BULK
	
	//InValues
	rBagActualMass              : REAL;     // aktualna masa bieżącego worka przed rozpoczęciem wysypu
    rDosedBatchActual           : REAL;     // aktualna rzeczywista ilość zadozowana w cyklu rSludge + rLime +rPerlite
    rMassBeforeDischarge		: REAL;		// stabilna masa przed wysypem odczytana z wagi zawiera wsad z cyklu + zaleganie
	rActualWeight               : REAL;     // aktualna masa batch procesu odczytywana z wagi
	bFlapClosed					: BOOL;		// potwierdzenie zamknięcia klapy 
    

END_VAR

VAR_OUTPUT
	//Status
    eFillMode                   : E_BigBagDischarge; // wybrany tryb wysypu
    bDone                       : BOOL;     // zakończony etap wysypu
	sDiag                       : T_MaxString; // komunikat diagnostyczny
	
	//OutValues
    rDischargedMassStep         : REAL;     // niestabilna masa zrzucona w aktualnym wysypie według bieżącego bilansu
    rMassMissingToBagTarget     : REAL;     // ile jeszcze brakuje do osiągnięcia targetu worka
    uiFlapPosSp                 : UINT;     // zadana pozycja klapy 0..100%
	
    
END_VAR

VAR
	bCloseRequested				: BOOL :=FALSE;  // żądanie zamknięcia klapy
    fbBulkTimer                 : TON;           // timer maksymalnego czasu wysypu bulk
	bEnablePrev                 : BOOL := FALSE; // poprzedni stan enable do wykrycia startu wysypu
	

	rBulkDoneThreshold			: REAL;		 // wyzwalanie warunku BULK
	rPreciseDoneThreshold		: REAL;      // wyzwalanie warunku PRECISE 
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ---------------------------------------------------------
// DOMYŚLNE WYJŚCIA
// ---------------------------------------------------------
uiFlapPosSp := 0;          // domyślnie klapa zamknięta
sDiag := '';               // domyślnie pusty komunikat


// ---------------------------------------------------------
// BLOK NIEAKTYWNY - RESET STANU
// ---------------------------------------------------------
IF NOT bEnable THEN
    fbBulkTimer(IN := FALSE, PT := tBulkDischargeTime_SP);

    bDone := FALSE;
    bCloseRequested := FALSE;
    bEnablePrev := FALSE;

    uiFlapPosSp := 0;
    rDischargedMassStep := 0.0;
	

    sDiag := 'BigBagDischarge idle';
    RETURN;
END_IF;


// ---------------------------------------------------------
// DETEKCJA STARTU NOWEGO WYSYPU
// ---------------------------------------------------------
IF bEnable AND NOT bEnablePrev THEN
    bDone := FALSE;
    bCloseRequested := FALSE;

    rMassMissingToBagTarget := rBagTargetMass_SP - rBagActualMass;

    IF rMassMissingToBagTarget < 0.0 THEN
        rMassMissingToBagTarget := 0.0;
    END_IF;

    // wybór trybu tylko raz, na starcie wysypu
    IF rDosedBatchActual <= rMassMissingToBagTarget THEN
        eFillMode := E_BigBagDischarge.BULK;      // cały nowy wsad mieści się do worka
    ELSE
        eFillMode := E_BigBagDischarge.PRECISE;   // ten cykl może domknąć worek
    END_IF;
END_IF;

bEnablePrev := bEnable;


// ---------------------------------------------------------
// JEŚLI JUŻ ZAKOŃCZONY - TRZYMAJ DONE DO ZDJĘCIA ENABLE
// ---------------------------------------------------------
IF bDone THEN
    uiFlapPosSp := 0;
    fbBulkTimer(IN := FALSE, PT := tBulkDischargeTime_SP);
    sDiag := 'Wysyp zakonczony - klapa zamknieta';
    RETURN;
END_IF;


// ---------------------------------------------------------
// OBLICZENIA BIEŻĄCE
// ---------------------------------------------------------
rDischargedMassStep := rMassBeforeDischarge - rActualWeight; // ile zeszło od stabilnej masy przed wysypem

IF rDischargedMassStep < 0.0 THEN
    rDischargedMassStep := 0.0;
END_IF;


// ---------------------------------------------------------
// PROGI ZAKOŃCZENIA WYSYPU
// ---------------------------------------------------------
rBulkDoneThreshold := rDosedBatchActual - rBatchDischargeToleranceKg;
IF rBulkDoneThreshold < 0.0 THEN
    rBulkDoneThreshold := 0.0;
END_IF;

rPreciseDoneThreshold := rMassMissingToBagTarget - rBatchDischargeToleranceKg;
IF rPreciseDoneThreshold < 0.0 THEN
    rPreciseDoneThreshold := 0.0;
END_IF;


// ---------------------------------------------------------
// OBSŁUGA ŻĄDANIA ZAMKNIĘCIA KLAPY
// ---------------------------------------------------------
IF bCloseRequested THEN
    uiFlapPosSp := 0;
    fbBulkTimer(IN := FALSE, PT := tBulkDischargeTime_SP);
    sDiag := 'Zamykanie klapy po wysypie';

    IF bFlapClosed THEN
        bDone := TRUE;
        sDiag := 'Wysyp zakonczony - klapa zamknieta';
    END_IF;

    RETURN;
END_IF;


// ---------------------------------------------------------
// LOGIKA TRYBÓW WYSYPU
// ---------------------------------------------------------
CASE eFillMode OF

    E_BigBagDischarge.BULK:
        sDiag := 'Wysyp bulk';
        uiFlapPosSp := uiFlapPosFast_SP;

        fbBulkTimer(IN := TRUE, PT := tBulkDischargeTime_SP);

        // zakończenie bulk:
        // 1) jeśli praktycznie cały nowy wsad już wyszedł
        // 2) albo jeśli minął maksymalny czas wysypu
        IF rDischargedMassStep >= rBulkDoneThreshold THEN
            bCloseRequested := TRUE;
            uiFlapPosSp := 0;
            fbBulkTimer(IN := FALSE, PT := tBulkDischargeTime_SP);

        ELSIF fbBulkTimer.Q THEN
            bCloseRequested := TRUE;
            uiFlapPosSp := 0;
            fbBulkTimer(IN := FALSE, PT := tBulkDischargeTime_SP);
        END_IF;


    E_BigBagDischarge.PRECISE:
        sDiag := 'Wysyp precyzyjny';
        uiFlapPosSp := uiFlapPosFine_SP;

        fbBulkTimer(IN := FALSE, PT := tBulkDischargeTime_SP);

        // w PRECISE kończymy względem masy brakującej do targetu worka,
        // a nie względem całego batcha
        IF rDischargedMassStep >= rPreciseDoneThreshold THEN
            bCloseRequested := TRUE;
            uiFlapPosSp := 0;
        END_IF;


ELSE
    uiFlapPosSp := 0;
    fbBulkTimer(IN := FALSE, PT := tBulkDischargeTime_SP);
END_CASE;]]></ST>
    </Implementation>
    <LineIds Name="FB_BigBagDischarge">
      <LineId Id="248" Count="18" />
      <LineId Id="437" Count="0" />
      <LineId Id="267" Count="124" />
