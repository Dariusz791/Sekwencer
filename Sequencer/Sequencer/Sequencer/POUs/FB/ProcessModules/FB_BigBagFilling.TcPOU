<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_BigBagFilling" Id="{4b05396b-16e8-4993-a107-cab30fc75e11}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_BigBagFilling
VAR_INPUT
    bEnable                     : BOOL;     // aktywacja bloku napełniania worka
    bConfirmBagChange           : BOOL;     // potwierdzenie wymiany worka przez operatora

    bLoadStartBagMass           : BOOL;     // żądanie ręcznego wczytania masy początkowej worka ze SCADA
    rStartBagMass               : REAL;     // masa początkowa worka wpisana ręcznie ze SCADA

    rReactorActualMass          : REAL;     // aktualna masa na wadze VR01 z czujnika tensometrycznego

    rBagTargetMass_SP           : REAL;     // zadana masa aktualnego Big Baga
    rBagToleranceKg             : REAL;     // tolerancja domknięcia worka, np. 5 kg

    rCycleMassActual            : REAL;     // rzeczywista masa aktualnego cyklu przygotowanego do wysypu - DeltaLime + DeltaSludge + DeltaPerlit
    rCycleDischargeToleranceKg  : REAL;     // tolerancja uznania, że bulk praktycznie cały już wyszedł

    tBulkDischargeTime_SP       : TIME;     // maksymalny czas wysypu w trybie BULK

    uiFlapPosFast_SP            : UINT;     // pozycja klapy dla szybkiego wysypu, np. 100%
    uiFlapPosFine_SP            : UINT;     // pozycja klapy dla wolnego / precyzyjnego wysypu, np. 30%
END_VAR

VAR_OUTPUT
    eState                      : E_BigBagFillingState; // aktualny stan wewnętrzny bloku
    eFillMode                   : E_BigBagFillMode;     // wybrany tryb wysypu: BULK albo PRECISE

    uiFlapPosSp                 : UINT;     // zadana pozycja klapy 0..100%

    rBagActualMass              : REAL := 0.0;   // aktualna masa bieżącego worka, narastająco z poprzednich i bieżącego wysypu
    rDischargedMassStep         : REAL := 0.0;   // masa zrzucona w aktualnym wysypie

    bBulkModeActive             : BOOL;     // informacja, że aktywny jest tryb BULK
    bPreciseModeActive          : BOOL;     // informacja, że aktywny jest tryb PRECISE

    bBagFilled                  : BOOL;     // bieżący worek osiągnął zadaną masę
    bBagChangeRequired          : BOOL;     // wymaganie wymiany worka
    bPauseForBagChange          : BOOL;     // pauza procesu na wymianę worka

    bFillDone                   : BOOL;     // zakończony aktualny wysyp
    bEn_Production              : BOOL;     // impuls 1 cykl PLC do zaksięgowania pełnego worka

    sDiag                       : T_MaxString; // komunikat diagnostyczny
END_VAR

VAR
    eStatePrev                  : E_BigBagFillingState := E_BigBagFillingState.IDLE; // poprzedni stan do detekcji zmiany kroku
    bStepInit                   : BOOL := FALSE;                                      // flaga wejścia w nowy krok

    fbBulkTimer                 : TON;       // timer maksymalnego czasu wysypu bulk
    rtLoadStartBagMass          : R_TRIG;    // detekcja zbocza narastającego sygnału ręcznego wczytania masy worka

    rReactorMassAtFillStart     : REAL := 0.0;   // masa reaktora na starcie aktualnego wysypu
    rBagMassBeforeFill          : REAL := 0.0;   // masa worka przed startem aktualnego wysypu

    rMassMissingToBagTarget     : REAL := 0.0;   // ile jeszcze brakuje do osiągnięcia targetu worka
END_VAR


]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ---------------------------------------------------------
// RECZNE WCZYTANIE MASY POCZATKOWEJ WORKA
// DOPUSZCZONE TYLKO W IDLE
// ---------------------------------------------------------
rtLoadStartBagMass(CLK := bLoadStartBagMass);

IF (eState = E_BigBagFillingState.IDLE) AND rtLoadStartBagMass.Q THEN
    rBagActualMass := rStartBagMass;        // ręczne ustawienie masy bieżącego worka
    rBagMassBeforeFill := rStartBagMass;    // masa worka przed kolejnym wysypem zgodna z wartością ręczną
END_IF;


// ---------------------------------------------------------
// PRZEJSCIE DO IDLE, GDY BLOK NIEAKTYWNY
// UWAGA: NIE ZERUJEMY rBagActualMass, BO MA PAMIETAC STAN WORKA
// ---------------------------------------------------------
IF NOT bEnable THEN
    eState := E_BigBagFillingState.IDLE;
END_IF;


// ---------------------------------------------------------
// DETEKCJA WEJSCIA W NOWY STAN
// ---------------------------------------------------------
IF eState <> eStatePrev THEN
    bStepInit := TRUE;
    eStatePrev := eState;
ELSE
    bStepInit := FALSE;
END_IF;


// ---------------------------------------------------------
// DOMYSLNE WYJSCIA CYKLICZNE
// ---------------------------------------------------------
uiFlapPosSp         := 0;           // domyślnie klapa zamknięta

bBulkModeActive     := FALSE;       // domyślnie brak aktywnego trybu BULK
bPreciseModeActive  := FALSE;       // domyślnie brak aktywnego trybu PRECISE

bFillDone           := FALSE;       // impuls zakończenia wysypu tylko w stanie DONE
bEn_Production      := FALSE;       // impuls produkcyjny tylko przy domknięciu worka

sDiag               := '';          // domyślnie pusty komunikat


// ---------------------------------------------------------
// STATUSY ZALEZNE OD STANU
// ---------------------------------------------------------
bBagFilled := (eState = E_BigBagFillingState.WAIT_BAG_CHANGE);         // worek pełny, gdy czekamy na wymianę
bBagChangeRequired := (eState = E_BigBagFillingState.WAIT_BAG_CHANGE); // żądanie wymiany worka
bPauseForBagChange := (eState = E_BigBagFillingState.WAIT_BAG_CHANGE); // pauza aktywna przy wymianie worka


// ---------------------------------------------------------
// OBLICZENIA WSPOLNE
// ---------------------------------------------------------
rMassMissingToBagTarget := rBagTargetMass_SP - rBagActualMass; // ile jeszcze brakuje do targetu worka
IF rMassMissingToBagTarget < 0.0 THEN
    rMassMissingToBagTarget := 0.0; // zabezpieczenie przed wartością ujemną
END_IF;


// ---------------------------------------------------------
// SEKWENCJA BLOKU
// ---------------------------------------------------------
CASE eState OF

    E_BigBagFillingState.IDLE:
        sDiag := 'BigBagFilling idle';

        uiFlapPosSp := 0; // klapa zamknięta
        fbBulkTimer(IN := FALSE, PT := tBulkDischargeTime_SP);

        rDischargedMassStep := 0.0; // w idle brak bieżącego wysypu
        eFillMode := E_BigBagFillMode.BULK; // wartość domyślna diagnostyczna

        IF bEnable THEN
            // zapamiętanie stanu na start nowego wysypu
            rReactorMassAtFillStart := rReactorActualMass; // masa reaktora na starcie aktualnego wysypu
            rBagMassBeforeFill := rBagActualMass;          // masa worka przed aktualnym wysypem

            // decyzja o trybie tylko raz, na starcie wysypu
            IF rCycleMassActual <= rMassMissingToBagTarget THEN
                eFillMode := E_BigBagFillMode.BULK; // cały cykl mieści się jeszcze do worka
                eState := E_BigBagFillingState.BULK_DISCHARGE;
            ELSE
                eFillMode := E_BigBagFillMode.PRECISE; // ten cykl może już domknąć worek
                eState := E_BigBagFillingState.PRECISE_DISCHARGE;
            END_IF;
        END_IF;


    E_BigBagFillingState.BULK_DISCHARGE:
        sDiag := 'Wysyp bulk';
        bBulkModeActive := TRUE;

        uiFlapPosSp := uiFlapPosFast_SP; // szybki wysyp - klapa szeroko otwarta
        fbBulkTimer(IN := TRUE, PT := tBulkDischargeTime_SP);

        // masa zrzucona tylko w aktualnym wysypie
        rDischargedMassStep := rReactorMassAtFillStart - rReactorActualMass;
        IF rDischargedMassStep < 0.0 THEN
            rDischargedMassStep := 0.0; // zabezpieczenie przed ujemnym wynikiem
        END_IF;

        // aktualna masa worka = to co było przed wysypem + to co doszło teraz
        rBagActualMass := rBagMassBeforeFill + rDischargedMassStep;

        // zakończenie BULK:
        // 1) jeśli praktycznie cały cykl już wyszedł
        // 2) albo jeśli minął maksymalny czas wysypu
        IF rDischargedMassStep >= (rCycleMassActual - rCycleDischargeToleranceKg) THEN
            uiFlapPosSp := 0; // zamknij klapę
            fbBulkTimer(IN := FALSE, PT := tBulkDischargeTime_SP);
            eState := E_BigBagFillingState.DONE;

        ELSIF fbBulkTimer.Q THEN
            uiFlapPosSp := 0; // zamknij klapę
            fbBulkTimer(IN := FALSE, PT := tBulkDischargeTime_SP);
            eState := E_BigBagFillingState.DONE;
        END_IF;


    E_BigBagFillingState.PRECISE_DISCHARGE:
        sDiag := 'Wysyp precyzyjny';
        bPreciseModeActive := TRUE;

        uiFlapPosSp := uiFlapPosFine_SP; // wolny / precyzyjny wysyp
        fbBulkTimer(IN := FALSE, PT := tBulkDischargeTime_SP);

        // masa zrzucona tylko w aktualnym wysypie
        rDischargedMassStep := rReactorMassAtFillStart - rReactorActualMass;
        IF rDischargedMassStep < 0.0 THEN
            rDischargedMassStep := 0.0; // zabezpieczenie przed ujemnym wynikiem
        END_IF;

        // aktualna masa worka = to co było przed wysypem + to co doszło teraz
        rBagActualMass := rBagMassBeforeFill + rDischargedMassStep;

        // domknięcie worka po osiągnięciu targetu w tolerancji
        IF rBagActualMass >= (rBagTargetMass_SP - rBagToleranceKg) THEN
            uiFlapPosSp := 0; // zamknij klapę

            bEn_Production := TRUE; // impuls do zaksięgowania pełnego worka
            eState := E_BigBagFillingState.WAIT_BAG_CHANGE;
        END_IF;


    E_BigBagFillingState.WAIT_BAG_CHANGE:
        sDiag := 'Oczekiwanie na wymiane worka';

        uiFlapPosSp := 0; // klapa zamknięta
        fbBulkTimer(IN := FALSE, PT := tBulkDischargeTime_SP);

        IF bConfirmBagChange THEN
            // po wymianie worka zaczynamy nowy worek od zera
            rBagActualMass := 0.0;      // nowy worek pusty
            rBagMassBeforeFill := 0.0;  // stan przed kolejnym wysypem = 0
            rDischargedMassStep := 0.0; // wyzerowanie aktualnego przyrostu

            eState := E_BigBagFillingState.DONE;
        END_IF;


    E_BigBagFillingState.DONE:
        sDiag := 'Aktualny wysyp zakonczony';

        uiFlapPosSp := 0; // klapa zamknięta
        fbBulkTimer(IN := FALSE, PT := tBulkDischargeTime_SP);

        bFillDone := TRUE; // informacja do sekwencera, że aktualny wysyp się zakończył

        IF NOT bEnable THEN
            eState := E_BigBagFillingState.IDLE;
        END_IF;


ELSE
    eState := E_BigBagFillingState.IDLE;
END_CASE;]]></ST>
    </Implementation>
    <LineIds Name="FB_BigBagFilling">
      <LineId Id="653" Count="179" />
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>