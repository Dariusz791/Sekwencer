  <POU Name="DewateringProcess" Id="{78b8de70-859f-4590-983a-34d148c9f601}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM DewateringProcess
VAR
	fbRouteManager			:	FB_RouteManager;
	fbProcessDiagnostics	:	FB_ProcessDiagnostics;
	fbDeviceDiagnostics		:	FB_DeviceDiagnostics;
	fbMainProcessSupervisor	:	FB_MainProcessSupervisor;
	
	fbDischargeR01ToVR01	:	FB_DischargeR01ToVR01;
	
	fbBigBagDischarge		:	FB_BigBagDischarge;
	fbBigBagMassBalance			:   FB_BigBagMassBalance;  			
	

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ACT_DeviceDiagnostics();
ACT_ProcessDiagnostics();
ACT_RouteManager();
ACT_MainProcessSupervisor();

ACT_BigBagDischarge();
ACT_BigBagMassBalance();

//ACT_BigBagFilling();
]]></ST>
    </Implementation>
