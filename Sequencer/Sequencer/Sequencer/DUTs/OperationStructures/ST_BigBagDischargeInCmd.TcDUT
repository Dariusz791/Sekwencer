  <DUT Name="ST_BigBagDischargeStatus_1" Id="{dea490ab-f2ab-4bb4-9340-fafb5ab7a2e3}">
    <Declaration><![CDATA[TYPE ST_BigBagDischargeStatus_1 :
STRUCT
    eFillMode               : E_BigBagFillMode; // wybrany tryb wysypu: BULK albo PRECISE
    uiFlapPosSp             : UINT;             // zadana pozycja klapy 0..100%
    bDone                   : BOOL;             // zakończony etap wysypu
    rDischargedMassStep     : REAL;             // orientacyjna masa zrzucona w aktualnym wysypie
    rMassMissingToBagTarget : REAL;             // ile jeszcze brakuje do osiągnięcia targetu worka
    sDiag                   : T_MaxString;      // komunikat diagnostyczny
END_STRUCT
END_TYPE
]]></Declaration>
