	bEn_BigBagMassBalance		: BOOL; // sterowanie blokiem bilansu masy w worku
	bEn_BigBagMassChangeHandler : BOOL; // sterowanie blokiem wymiany worka i zapisu wartości poczatkowej do worka jesli rozna od zera
