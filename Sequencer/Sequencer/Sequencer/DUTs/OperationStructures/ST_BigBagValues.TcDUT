  <DUT Name="ST_BigBagValues" Id="{b7b1c82e-aaa6-4c95-91b2-46a88ecff018}">
    <Declaration><![CDATA[TYPE ST_BigBagValues :
STRUCT
    rBagActualMass          : REAL; // aktualna masa bieżącego worka
    rDosedBatchActual       : REAL; // rzeczywista masa wsadu zadozowanego w aktualnym cyklu
    rMassBeforeDischarge    : REAL; // stabilna masa przed wysypem
    rMassAfterDischarge     : REAL; // stabilna masa po wysypie
    rDischargeMass          : REAL; // rzeczywista masa wyładowana po ocenie
END_STRUCT
END_TYPE
]]></Declaration>
