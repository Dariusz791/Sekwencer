<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <EnumerationTextList Name="E_DischargeState" Id="{785c0cbe-b136-4106-8d69-db7636c5a1e6}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_DischargeState :
(
    IDLE,                    // blok nieaktywny
    DOSE_SLUDGE,             // dozowanie osadu
    DOSE_PERLITE,            // dozowanie perlitu
    DOSE_LIME,               // dozowanie wapna
    MIXING,                  // mieszanie wsadu przed wysypem

    DISCHARGE_RUN,           // właściwy wysyp do Big Baga
    STOP_DRIVE_FOR_WEIGHING, // zatrzymanie napędu i zamykanie klapy przed ważeniem
    WAIT_SCALE_SETTLE,       // oczekiwanie na ustabilizowanie wagi
    EVALUATE_DISCHARGE,      // ocena efektu wysypu po stabilizacji wagi

    WAIT_BAG_CHANGE,         // oczekiwanie na wymianę worka
    DONE                     // zakończona operacja
);
END_TYPE
]]></Declaration>
